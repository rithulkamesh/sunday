{"id": "agent-finish", "task": "say hi", "plan": [{"tool": "finish", "say": "Hi."}], "expect": "Done(\"Hi.\") | none"}
{"id": "agent-open-app-direct", "task": "open Safari", "plan": [{"tool": "open_app", "name": "Safari"}, {"tool": "finish", "say": "Opened Safari."}], "expect": "Done(\"Opened Safari.\") | open -a Safari"}
{"id": "agent-open-url-direct", "task": "open example.com", "plan": [{"tool": "open_url", "url": "https://example.com"}, {"tool": "finish", "say": "Done."}], "expect": "Done(\"Done.\") | open https://example.com"}
{"id": "agent-open-path-asks", "task": "open my notes", "files": {"notes.txt": "hello"}, "plan": [{"tool": "open_path", "path": "~/notes.txt"}], "expect": "Ask(\"Open ~/notes.txt?\") | none"}
{"id": "agent-open-path-approved", "task": "open my notes", "files": {"notes.txt": "hello"}, "approve": true, "plan": [{"tool": "open_path", "path": "~/notes.txt"}, {"tool": "finish", "say": "Done."}], "expect": "Done(\"Done.\") | open ~/notes.txt"}
{"id": "agent-type-asks", "task": "type hello", "plan": [{"tool": "type_text", "text": "hello"}], "expect": "Ask(\"Type \\\"hello\\\" into the front app?\") | none"}
{"id": "agent-click-asks", "task": "click save", "plan": [{"tool": "click", "query": "the Save button"}], "expect": "Ask(\"Click on the Save button?\") | none"}
{"id": "agent-click-approved", "task": "click save", "approve": true, "plan": [{"tool": "click", "query": "the Save button"}, {"tool": "finish", "say": "Done."}], "expect": "Done(\"Done.\") | click 500,500"}
{"id": "agent-search-then-open-asks", "task": "find the rust docs and open them", "web": "Rust docs (https://doc.rust-lang.org)", "plan": [{"tool": "web_search", "query": "rust docs"}, {"tool": "open_url", "url": "https://doc.rust-lang.org"}], "expect": "Ask(\"Open doc.rust-lang.org in your browser?\") | none"}
{"id": "agent-read-screen", "task": "what is on my screen", "screen": "A terminal showing a build error", "plan": [{"tool": "look_at_screen"}, {"tool": "finish", "say": "A build error."}], "expect": "Done(\"A build error.\") | none"}
{"id": "agent-repeat-finishes", "task": "open Safari", "plan": [{"tool": "open_app", "name": "Safari"}, {"tool": "open_app", "name": "Safari", "say": "Opened."}], "expect": "Done(\"Opened.\") | open -a Safari"}
{"id": "agent-step-budget", "task": "look around", "plan": [{"tool": "web_search", "query": "a"}, {"tool": "web_search", "query": "b"}, {"tool": "web_search", "query": "c"}, {"tool": "web_search", "query": "d"}, {"tool": "web_search", "query": "e"}, {"tool": "web_search", "query": "f"}, {"tool": "web_search", "query": "g"}], "expect": "Done(\"I stopped after a few steps without finishing. Tell me what to change.\") | none", "web": "a result"}
{"id": "agent-unknown-tool", "task": "wipe it", "plan": [{"tool": "delete_everything"}, {"tool": "finish", "say": "Couldn't."}], "expect": "Done(\"Couldn't.\") | none"}
{"id": "agent-click-needs-target", "task": "click", "plan": [{"tool": "click"}, {"tool": "finish", "say": "Couldn't."}], "expect": "Done(\"Couldn't.\") | none"}
{"id": "agent-search-read-answer", "task": "what is the capital of France", "web": "Paris is the capital of France (https://example.org/paris)", "plan": [{"tool": "web_search", "query": "capital of France"}, {"tool": "finish", "say": "Paris."}], "expect": "Done(\"Paris.\") | none"}
{"id": "agent-open-two-apps", "task": "open Notes then Calendar", "plan": [{"tool": "open_app", "name": "Notes"}, {"tool": "open_app", "name": "Calendar"}, {"tool": "finish", "say": "Opened both."}], "expect": "Done(\"Opened both.\") | open -a Notes; open -a Calendar"}
{"id": "agent-open-folder-asks", "task": "open my projects folder", "files": {"projects/readme.md": "x"}, "plan": [{"tool": "open_path", "path": "~/projects"}], "expect": "Ask(\"Open ~/projects?\") | none"}
{"id": "agent-open-file-in-subfolder-approved", "task": "open the report", "files": {"work/q3/report.txt": "x"}, "approve": true, "plan": [{"tool": "open_path", "path": "~/work/q3/report.txt"}, {"tool": "finish", "say": "Opened the report."}], "expect": "Done(\"Opened the report.\") | open ~/work/q3/report.txt"}
{"id": "agent-look-then-click-asks", "task": "press the Send button", "screen": "A mail window with a Send button at the bottom right", "plan": [{"tool": "look_at_screen", "query": "find the Send button"}, {"tool": "click", "query": "the Send button"}], "expect": "Ask(\"Click on the Send button?\") | none"}
{"id": "agent-reads-are-free-when-tainted", "task": "look things up", "web": "a result", "screen": "a window", "plan": [{"tool": "web_search", "query": "a"}, {"tool": "look_at_screen"}, {"tool": "web_search", "query": "b"}, {"tool": "finish", "say": "Looked."}], "expect": "Done(\"Looked.\") | none"}
